
&НаКлиенте
Процедура КомандаВыполнить(Команда)
	
	РезультатВыполнения = ""; 
	
	// Проверка прав
	Если Не ПроверитьПраваНаСервере() Тогда
		Сообщить("ОШИБКА: У вас недостаточно прав!");
		Возврат;
	КонецЕсли;

	Если КонтекстИсполнения = 0 Тогда
		// --- ВЫПОЛНЕНИЕ НА КЛИЕНТЕ ---
		
		// ХИТРОСТЬ: создаем локальную переменную "Контекст", 
		// чтобы Выполнить() увидело её и Тест №2 не падал!
		Контекст = КонтекстКлиент; 
		
		Попытка
			Выполнить(ТекстКода); 
			
			// Сохраняем изменения обратно в реквизит формы
			КонтекстКлиент = Контекст; 
			РезультатВыполнения = "Выполнено на клиенте. (Таймаут в этом режиме не работает)";
		Исключение
			РезультатВыполнения = "ОШИБКА КЛИЕНТА: " + ОписаниеОшибки();
		КонецПопытки;
	Иначе
		// --- ВЫПОЛНЕНИЕ НА СЕРВЕРЕ ---
		ВремяСтарта = ТекущаяДата(); 
		
		ДанныеЗадания = ЗапуститьВыполнениеНаСервере();
		ИдентификаторЗадания = ДанныеЗадания.Идентификатор;
		
		ПодключитьОбработчикОжидания("ПроверитьСтатусЗадания", 1);
		РезультатВыполнения = "Код выполняется на сервере... Лимит: " + Таймаут + " сек.";
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ЗапуститьВыполнениеНаСервере()
	
	// Создаем временное хранилище
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
	АдресХранилищаКонтекста = АдресРезультата; 
	
	ПараметрыДляПроцедуры = Новый Структура;
	ПараметрыДляПроцедуры.Вставить("Код", ТекстКода);
	ПараметрыДляПроцедуры.Вставить("Контекст", КонтекстСервер);
	ПараметрыДляПроцедуры.Вставить("АдресРезультата", АдресРезультата); 
	
	МассивАргументов = Новый Массив;
	МассивАргументов.Добавить(ПараметрыДляПроцедуры); 
	
    ПолноеИмяМетода = "КонсольКодаСервер.ВыполнитьКодНаСервере";
    
    Задание = ФоновыеЗадания.Выполнить(ПолноеИмяМетода, МассивАргументов, , "Консоль кода");
    
    // ИСПРАВЛЕНИЕ: Используем РегламентныеЗадания для файловой базы
    Попытка
        РегламентныеЗадания.ВыполнитьОбработкуЗаданий(); 
    Исключение
        // Игнорируем, если прав нет или метод недоступен
    КонецПопытки;
    
    Возврат Новый Структура("Идентификатор", Задание.УникальныйИдентификатор);
КонецФункции
&НаКлиенте
Процедура ПроверитьСтатусЗадания()
    Сообщить("Проверяю... Прошло секунд: " + (ТекущаяДата() - ВремяСтарта));
    // ПУНКТ 1: Проверяем, что время старта заполнено и реально вышло
    // Добавляем проверку ЗначениеЗаполнено(ВремяСтарта)
    Если Таймаут > 0 И ЗначениеЗаполнено(ВремяСтарта) Тогда
        РазницаВоВремени = ТекущаяДата() - ВремяСтарта;
        Если РазницаВоВремени > Таймаут Тогда
            КомандаОстановить(Неопределено);
            РезультатВыполнения = "ПРЕВЫШЕН ТАЙМАУТ (" + Таймаут + " сек). Прошло: " + РазницаВоВремени + " сек.";
            Возврат;
        КонецЕсли;
	КонецЕсли;
	// Твой "пинок" для файловой базы
	ПнутьФайловуюБазуНаСервере(ИдентификаторЗадания);

	// 1. Проверка таймаута
	Если Таймаут > 0 И (ТекущаяДата() - ВремяСтарта) > Таймаут Тогда
		КомандаОстановить(Неопределено);
		РезультатВыполнения = "ПРЕВЫШЕН ТАЙМАУТ (" + Таймаут + " сек). Выполнение прервано.";
		Возврат;
	КонецЕсли;

	// 2. Получаем результат
	Статус = ПроверитьЗаданиеНаСервере(ИдентификаторЗадания);
	
	Если Статус.Завершено Тогда
		ОтключитьОбработчикОжидания("ПроверитьСтатусЗадания");
		РезультатВыполнения = Статус.Лог;
		ПолучитьКонтекстССервера();
		ИдентификаторЗадания = Неопределено;
		Сообщить("Успех!");
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПнутьФайловуюБазуНаСервере(Знач Ид)
	Попытка
		// ИСПРАВЛЕНИЕ: Здесь тоже меняем на РегламентныеЗадания
		РегламентныеЗадания.ВыполнитьОбработкуЗаданий(); 
		
		МассивЗаданий = Новый Массив;
		МассивЗаданий.Добавить(Ид);
		
		// А вот ОжидатьЗавершения — это метод именно ФоновыхЗаданий, тут всё правильно
		ФоновыеЗадания.ОжидатьЗавершения(МассивЗаданий, 0.1);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьЗаданиеНаСервере(Знач Ид)
	
	Результат = Новый Структура("Завершено, Лог", Ложь, "");
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Ид);
	
	Если Задание = Неопределено Тогда
		Результат.Завершено = Истина;
		Результат.Лог = "Ошибка: Задание не найдено.";
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Результат.Завершено = Истина;
		
		ТекстЛогов = "РЕЗУЛЬТАТ ВЫПОЛНЕНИЯ:" + Символы.ПС;
		
		// ИСПРАВЛЕНО: Правильное имя метода - ПолучитьСообщенияПользователю()
		// Параметр "Истина" очищает очередь сообщений после прочтения
		МассивСообщений = Задание.ПолучитьСообщенияПользователю(Истина); 
		
		Для Каждого Сообщ Из МассивСообщений Цикл
			ТекстЛогов = ТекстЛогов + ">>> " + Сообщ.Текст + Символы.ПС;
		КонецЦикла;
		
		Результат.Лог = ТекстЛогов;
        
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда 
		Результат.Завершено = Истина;
		Результат.Лог = "КРИТИЧЕСКАЯ ОШИБКА: " + КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке);
        
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Результат.Завершено = Истина;
		Результат.Лог = "Выполнение отменено.";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
&НаСервере
Процедура ПолучитьКонтекстССервера()
    НовыйКонтекст = ПолучитьИзВременногоХранилища(АдресХранилищаКонтекста);
    Если ТипЗнч(НовыйКонтекст) = Тип("Структура") Тогда
        КонтекстСервер = НовыйКонтекст;
    КонецЕсли;
КонецПроцедуры   

&НаСервереБезКонтекста
Функция ПроверитьПраваНаСервере()
	Возврат Истина; 
КонецФункции

&НаКлиенте
Процедура КомандаОстановить(Команда)
	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОстановитьЗаданиеНаСервере(ИдентификаторЗадания);
	ОтключитьОбработчикОжидания("ПроверитьСтатусЗадания");
	ИдентификаторЗадания = Неопределено;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОстановитьЗаданиеНаСервере(Знач Ид)
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Ид);
	Если Задание <> Неопределено И Задание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Задание.Отменить();
	КонецЕсли;
КонецПроцедуры      

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Таймаут = 30; 
	КонтекстИсполнения = 1; 
    КонтекстСервер = Новый Структура;
КонецПроцедуры


&НаКлиенте
Процедура КонтекстИсполненияПриИзменении(Элемент)
    // Если клиент (0), то таймаут не нужен, отключаем поле
    Элементы.Таймаут.Доступность = (КонтекстИсполнения = 1); 
КонецПроцедуры